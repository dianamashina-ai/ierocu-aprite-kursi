# ──────────────────────────────────────────────────────────────
# Kopē uz .env.local (Next.js) un .env (skripti: seed, migrācijas).
# Īstas vērtības NEKAD neliec repozitorijā.
# ──────────────────────────────────────────────────────────────

# PostgreSQL savienojums. Lokāli — vietējais Postgres vai `supabase start`;
# produkcijā — Supabase "Connection string" (Transaction pooler, ports 6543).
DATABASE_URL=postgres://app:app@localhost:5432/ierocu

# Atsevišķa datubāze testiem (tiek iztīrīta testu laikā!). Ja nav — DB testi tiek izlaisti.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/ierocu_test

# Publiskā vietnes adrese (saitēm e-pastos, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Pieslēgšanās (better-auth) ──
# Nejauša virkne vismaz 32 rakstzīmes: `openssl rand -base64 32`. Produkcijā — sava, slepena.
BETTER_AUTH_SECRET=
# Vietnes adrese pieslēgšanās saitēm un drošības pārbaudēm (produkcijā = https://tavs-domens.lv)
BETTER_AUTH_URL=http://localhost:3000
# Google pieslēgšanās (neobligāti). Ja abi tukši — poga netiek rādīta.
# Redirect URI Google konsolē: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-pasts (Resend) ──
# Ja tukšs, e-pasti (pieslēgšanās saites, paroles maiņa) tiek izdrukāti konsolē
# un redzami /api/dev/outbox (tikai izstrādē).
RESEND_API_KEY=
EMAIL_FROM="Ieroču atļauja <noreply@tavs-domens.lv>"

# ── Maksājumi (5. posms) ──
# Kura sistēma: stripe | montonio | dev. Ja tukšs — izstrādē "dev" (testa maksājums bez naudas),
# produkcijā pirkšana izslēgta. Testa maksājumi produkcijā tikai ar ALLOW_TEST_PAYMENTS=1 (priekšskatījumam).
PAYMENT_PROVIDER=
ALLOW_TEST_PAYMENTS=

# Stripe (karte). Webhook adrese: <NEXT_PUBLIC_SITE_URL>/api/maksajumi/stripe
# Notikumi: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Montonio (internetbanka). Paziņojumu adrese tiek nosūtīta automātiski: <NEXT_PUBLIC_SITE_URL>/api/maksajumi/montonio
MONTONIO_ACCESS_KEY=
MONTONIO_SECRET_KEY=
# 1 = sandbox (testa) vide
MONTONIO_SANDBOX=

# ── Administrēšana ──
# Administratoru e-pasti (ar komatu). Viņiem redzama poga "Labot" un lapa /labojumi.
ADMIN_EMAILS=
# Atslēga izstrādātāja piekļuvei piezīmēm caur /api/labojumi (vismaz 32 rakstzīmes; `openssl rand -base64 48`)
NOTES_API_KEY=

# Meklētājprogrammu indeksēšana: 1 = atļauta (ieslēgt tikai pēc palaišanas)
SITE_INDEXING=
